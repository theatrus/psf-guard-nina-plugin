<ResourceDictionary
    x:Class="PsfGuard.Nina.Plugin.Sequence.SequenceTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PsfGuard.Nina.Plugin.Sequence"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">

    <DataTemplate DataType="{x:Type local:CheckPsfGuardConnection}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock Text="Verify server, token, and catalog" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:PullPsfGuardPlanning}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock Text="PSF Guard to Target Scheduler" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:PullPsfGuardGrades}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock Text="Reviewed grades to Target Scheduler" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:ReconcilePsfGuardCatalog}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock Text="Push all structure and captures" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:ReconcilePsfGuardTarget}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock Text="Push enclosing target and captures" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:ReconcilePsfGuardTargetAfterExposures}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Reconcile target every" />
                    <TextBox
                        Width="48"
                        Margin="8,0"
                        HorizontalContentAlignment="Right"
                        Text="{Binding AfterExposures, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="light exposure(s)" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
            <nina:SequenceBlockView.SequenceItemProgressContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Exposure" />
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding ProgressExposures}" />
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="of" />
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding AfterExposures}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemProgressContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:UploadPsfGuardImageAfterExposure}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Upload lights" />
                    <CheckBox
                        Margin="6,0,14,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding UploadLights}" />
                    <TextBlock VerticalAlignment="Center" Text="Calibration" />
                    <CheckBox
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding UploadCalibrationFrames}" />
                </StackPanel>
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="PsfGuard.Nina.Plugin.Sequence.CheckPsfGuardConnection_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <TextBlock Text="Check PSF Guard" />
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>

    <DataTemplate x:Key="PsfGuard.Nina.Plugin.Sequence.PullPsfGuardPlanning_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <TextBlock Text="Pull planning" />
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>

    <DataTemplate x:Key="PsfGuard.Nina.Plugin.Sequence.PullPsfGuardGrades_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <TextBlock Text="Pull grades" />
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>

    <DataTemplate x:Key="PsfGuard.Nina.Plugin.Sequence.ReconcilePsfGuardCatalog_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <TextBlock Text="Reconcile catalog" />
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>

    <DataTemplate x:Key="PsfGuard.Nina.Plugin.Sequence.ReconcilePsfGuardTarget_Mini">
        <mini:MiniSequenceItem>
            <mini:MiniSequenceItem.SequenceItemContent>
                <TextBlock Text="Reconcile target" />
            </mini:MiniSequenceItem.SequenceItemContent>
        </mini:MiniSequenceItem>
    </DataTemplate>

    <DataTemplate x:Key="PsfGuard.Nina.Plugin.Sequence.ReconcilePsfGuardTargetAfterExposures_Mini">
        <mini:MiniTrigger>
            <mini:MiniTrigger.TriggerProgressContent>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Exposure" />
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding ProgressExposures}" />
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="of" />
                    <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{Binding AfterExposures}" />
                </StackPanel>
            </mini:MiniTrigger.TriggerProgressContent>
        </mini:MiniTrigger>
    </DataTemplate>

    <DataTemplate x:Key="PsfGuard.Nina.Plugin.Sequence.UploadPsfGuardImageAfterExposure_Mini">
        <mini:MiniTrigger>
            <mini:MiniTrigger.TriggerProgressContent>
                <TextBlock Text="Upload saved image" />
            </mini:MiniTrigger.TriggerProgressContent>
        </mini:MiniTrigger>
    </DataTemplate>
</ResourceDictionary>
