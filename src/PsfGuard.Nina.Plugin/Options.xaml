<ResourceDictionary
    x:Class="PsfGuard.Nina.Plugin.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="PSF Guard Sync_Options">
        <Grid MaxWidth="760">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,10"
                VerticalAlignment="Center"
                Text="Enable PSF Guard sync" />
            <CheckBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,10"
                HorizontalAlignment="Left"
                IsChecked="{Binding Enabled}" />

            <TextBlock Grid.Row="1" Margin="0,4,12,4" VerticalAlignment="Center" Text="Server URL" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                MinWidth="420"
                Margin="0,4"
                Text="{Binding ServerUrl, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="2" Margin="0,4,12,4" VerticalAlignment="Center" Text="Catalog ID" />
            <TextBox
                Grid.Row="2"
                Grid.Column="1"
                Margin="0,4"
                Text="{Binding CatalogId, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="3" Margin="0,4,12,4" VerticalAlignment="Center" Text="Remote API key" />
            <TextBox
                Grid.Row="3"
                Grid.Column="1"
                Margin="0,4"
                Text="{Binding ApiToken, UpdateSourceTrigger=LostFocus}" />

            <TextBlock Grid.Row="4" Margin="0,4,12,4" VerticalAlignment="Center" Text="Scheduler database (optional)" />
            <TextBox
                Grid.Row="4"
                Grid.Column="1"
                Margin="0,4"
                Text="{Binding TargetSchedulerDatabase, UpdateSourceTrigger=LostFocus}" />

            <Grid Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Text="Automatically upload saved light images" />
                <CheckBox
                    Grid.Row="0"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding UploadCapturedImages}" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    VerticalAlignment="Center"
                    Text="Also upload calibration frames" />
                <CheckBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding UploadCalibrationImages}"
                    IsEnabled="{Binding UploadCapturedImages}" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,5,0,0"
                    VerticalAlignment="Center"
                    Text="Push each saved light's Target Scheduler record" />
                <CheckBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding AutoPushCaptures}" />
                <TextBlock
                    Grid.Row="3"
                    Margin="0,5,0,0"
                    VerticalAlignment="Center"
                    Text="Apply remote previews automatically" />
                <CheckBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding AutoApplyPushes}" />
                <TextBlock
                    Grid.Row="4"
                    Margin="0,5,0,0"
                    VerticalAlignment="Center"
                    Text="Include Target Scheduler thumbnails" />
                <CheckBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding IncludeThumbnails}" />
            </Grid>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,14,0,0" Orientation="Horizontal">
                <Button
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Command="{Binding TestConnectionCommand}"
                    Content="Test connection" />
                <Button
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Command="{Binding PushAllCommand}"
                    Content="Push all" />
                <Button
                    MinWidth="120"
                    Command="{Binding PullPlanningCommand}"
                    Content="Pull planning" />
            </StackPanel>

            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,8,0,0" Orientation="Horizontal">
                <Button
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Command="{Binding PushPlanningCommand}"
                    Content="Push planning" />
                <Button
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Command="{Binding PushGradesCommand}"
                    Content="Push grades" />
                <Button
                    MinWidth="120"
                    Command="{Binding PullGradesCommand}"
                    Content="Pull grades" />
            </StackPanel>

            <Border
                Grid.Row="8"
                Grid.ColumnSpan="2"
                Margin="0,14,0,0"
                Padding="10"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1">
                <TextBlock Text="{Binding LastStatus}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
