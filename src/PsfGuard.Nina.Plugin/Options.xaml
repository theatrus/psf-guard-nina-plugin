<ResourceDictionary
  x:Class="PsfGuard.Nina.Plugin.Options"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DataTemplate x:Key="PSF Guard Sync_Options">
    <StackPanel MaxWidth="760" Loaded="OptionsLoaded">
      <StackPanel.Resources>
        <Style x:Key="SectionStyle" TargetType="{x:Type GroupBox}">
          <Setter Property="Margin" Value="0,0,0,10" />
          <Setter Property="Padding" Value="12" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="OptionStyle" TargetType="{x:Type CheckBox}">
          <Setter Property="Margin" Value="0,0,0,7" />
          <Setter Property="ContentTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="ActionLabelStyle" BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="{x:Type TextBlock}">
          <Setter Property="Margin" Value="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
          <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        </Style>
        <Style x:Key="ActionStyle" BasedOn="{StaticResource StandardButton}" TargetType="{x:Type Button}">
          <Setter Property="MinWidth" Value="128" />
          <Setter Property="Margin" Value="0,0,8,8" />
          <Setter Property="Padding" Value="10,3" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type Label}">
          <Setter Property="Margin" Value="0,5,0,3" />
          <Setter Property="Padding" Value="0" />
        </Style>
      </StackPanel.Resources>

      <GroupBox Header="Connection" Style="{StaticResource SectionStyle}">
        <StackPanel>
          <Label
            Content="Server URL"
            Style="{StaticResource FieldLabelStyle}"
            Target="{Binding ElementName=ServerUrlBox}" />
          <TextBox
            x:Name="ServerUrlBox"
            IsEnabled="{Binding IsSettingsEditable}"
            Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />

          <TextBlock Margin="0,8,0,4" TextWrapping="Wrap"
            Text="Pair only with a server you trust. Pairing sends your machine and profile names; sync can send catalog metadata and file paths, and uploads send original images and their headers." />
          <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
            <Hyperlink
              Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TextBlock}}}"
              NavigateUri="https://github.com/theatrus/psf-guard-nina-plugin/blob/main/docs/PRIVACY.md"
              RequestNavigate="PrivacyLinkRequestNavigate">Data and privacy</Hyperlink>
            <Run Text=". Pairing does not enable capture automation or image uploads." />
          </TextBlock>

          <StackPanel Margin="0,9,0,3" Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0" Text="Pairing status" />
            <TextBlock FontWeight="SemiBold" Text="{Binding PairingStatus}" />
          </StackPanel>

          <Label
            Content="Catalog ID"
            Style="{StaticResource FieldLabelStyle}"
            Target="{Binding ElementName=CatalogIdBox}" />
          <TextBox
            x:Name="CatalogIdBox"
            IsReadOnly="True"
            Text="{Binding CatalogId, Mode=OneWay}" />

          <Label
            Content="One-time pairing code"
            Style="{StaticResource FieldLabelStyle}"
            Target="{Binding ElementName=PairingCodeBox}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
              x:Name="PairingCodeBox"
              IsEnabled="{Binding IsSettingsEditable}"
              VerticalAlignment="Center"
              Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}" />
            <Button
              Grid.Column="1"
              MinWidth="96"
              Margin="8,0,0,0"
              Padding="10,2"
              Command="{Binding PairCommand}">
              <TextBlock Text="Pair" Style="{StaticResource ActionLabelStyle}" />
            </Button>
          </Grid>

          <WrapPanel Margin="0,8,0,0">
            <Button
              MinWidth="128"
              Margin="0,0,8,0"
              Padding="10,3"
              HorizontalAlignment="Left"
              Command="{Binding TestConnectionCommand}">
              <TextBlock Text="Test connection" Style="{StaticResource ActionLabelStyle}" />
            </Button>
            <Button
              MinWidth="128"
              Padding="10,3"
              Command="{Binding ResetPairingCommand}">
              <TextBlock Text="Reset pairing" Style="{StaticResource ActionLabelStyle}" />
            </Button>
          </WrapPanel>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Capture and sequencer automation" Style="{StaticResource SectionStyle}">
        <StackPanel>
          <CheckBox
            Margin="0,0,0,8"
            FontWeight="SemiBold"
            Content="Enable PSF Guard for this N.I.N.A. profile"
            IsChecked="{Binding Enabled}"
            Style="{StaticResource OptionStyle}" />
          <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
            Text="Turning this off stops new capture automation and sequencer sync, not queued transfers. Manual commands remain available." />
          <Separator Margin="0,0,0,10" />
          <StackPanel Margin="20,0,0,0" IsEnabled="{Binding Enabled}">
            <TextBlock
              Margin="0,0,0,7"
              FontWeight="SemiBold"
              Text="Saved-image automation" />
            <CheckBox
              Content="Automatically push saved light records"
              IsChecked="{Binding AutoPushCaptures}"
              Style="{StaticResource OptionStyle}" />
            <CheckBox
              Content="Automatically upload saved images"
              IsChecked="{Binding UploadCapturedImages}"
              Style="{StaticResource OptionStyle}" />
            <CheckBox
              Margin="20,0,0,7"
              Content="Also upload calibration frames"
              IsChecked="{Binding UploadCalibrationImages}"
              IsEnabled="{Binding UploadCapturedImages}"
              Style="{StaticResource OptionStyle}" />
            <TextBlock
              Margin="0,5,0,7"
              FontWeight="SemiBold"
              Text="All image uploads" />
            <CheckBox
              Margin="0,0,0,7"
              Content="Defer image uploads until released"
              IsChecked="{Binding DeferImageUploads}"
              Style="{StaticResource OptionStyle}" />
          </StackPanel>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Queue recovery" Style="{StaticResource SectionStyle}">
        <StackPanel>
          <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
            Text="Queued transfers can resume when N.I.N.A. starts, even with automation off. They keep their original server, catalog, and profile. Close N.I.N.A. to stop local transfers; revoke the pairing on the server to prevent future access." />
          <WrapPanel>
            <Button
              Command="{Binding StartQueuedUploadsCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Start queued uploads" Style="{StaticResource ActionLabelStyle}" />
            </Button>
            <Button
              Command="{Binding RetryBlockedCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Retry blocked" Style="{StaticResource ActionLabelStyle}" />
            </Button>
          </WrapPanel>
          <TextBlock Margin="0,12,0,8" TextWrapping="Wrap"
            Text="PSF Guard refuses an upload when the frame's project was deleted or the frame was removed as a reject. The queue holds such uploads without retrying them. After you allow the project back or restore the reject in PSF Guard, select Retry refused uploads. Forget refused uploads removes the held uploads from the queue; the image files stay on disk." />
          <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{Binding RefusedUploadsStatus}" />
          <WrapPanel>
            <Button
              Command="{Binding RetryRefusedUploadsCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Retry refused uploads" Style="{StaticResource ActionLabelStyle}" />
            </Button>
            <Button
              Command="{Binding ForgetRefusedUploadsCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Forget refused uploads" Style="{StaticResource ActionLabelStyle}" />
            </Button>
          </WrapPanel>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Catalog synchronization" Style="{StaticResource SectionStyle}">
        <StackPanel>
          <Label
            Content="Target Scheduler database"
            Style="{StaticResource FieldLabelStyle}"
            Target="{Binding ElementName=SchedulerDatabaseBox}" />
          <TextBox
            x:Name="SchedulerDatabaseBox"
            Margin="0,0,0,10"
            Text="{Binding TargetSchedulerDatabase, UpdateSourceTrigger=PropertyChanged}" />
          <CheckBox
            Content="Apply remote previews automatically"
            IsChecked="{Binding AutoApplyPushes}"
            Style="{StaticResource OptionStyle}" />
          <CheckBox
            Content="Include Target Scheduler thumbnails"
            IsChecked="{Binding IncludeThumbnails}"
            Style="{StaticResource OptionStyle}" />
          <CheckBox
            Content="Pull the merged catalog back after full reconcile"
            IsChecked="{Binding RoundTripReconcile}"
            Style="{StaticResource OptionStyle}" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Catalog actions" Style="{StaticResource SectionStyle}">
        <StackPanel>
          <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
            Text="Pulls and round-trip reconcile change the local Target Scheduler database. Grades update accepted counts; explicit flat coverage invalidations can cause flats to be retaken. Back up first, and pull planning or a full catalog only when Target Scheduler is not running a target container." />
          <WrapPanel>
            <Button
              Command="{Binding ReconcileCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Reconcile" Style="{StaticResource ActionLabelStyle}" />
            </Button>
            <Button
              Command="{Binding PushAllCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Push all" Style="{StaticResource ActionLabelStyle}" />
            </Button>
            <Button
              Command="{Binding PullMergedCatalogCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Pull catalog" Style="{StaticResource ActionLabelStyle}" />
            </Button>
          </WrapPanel>
          <WrapPanel>
            <Button
              Command="{Binding PushPlanningCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Push planning" Style="{StaticResource ActionLabelStyle}" />
            </Button>
            <Button
              Command="{Binding PullPlanningCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Pull planning" Style="{StaticResource ActionLabelStyle}" />
            </Button>
            <Button
              Command="{Binding PushGradesCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Push grades" Style="{StaticResource ActionLabelStyle}" />
            </Button>
            <Button
              Command="{Binding PullGradesCommand}"
              Style="{StaticResource ActionStyle}">
              <TextBlock Text="Pull grades" Style="{StaticResource ActionLabelStyle}" />
            </Button>
          </WrapPanel>

          <Separator Margin="0,2,0,10" />
          <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Pending preview" />
          <TextBlock Text="{Binding PendingPreviewStatus}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,8,0,0">
            <Button
              MinWidth="110"
              Margin="0,0,8,8"
              Padding="10,3"
              Command="{Binding ApplyPreviewCommand}">
              <TextBlock Text="Apply preview" Style="{StaticResource ActionLabelStyle}" />
            </Button>
            <Button
              MinWidth="110"
              Margin="0,0,8,8"
              Padding="10,3"
              Command="{Binding ForgetPreviewCommand}">
              <TextBlock Text="Forget preview" Style="{StaticResource ActionLabelStyle}" />
            </Button>
          </WrapPanel>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="Activity" Style="{StaticResource SectionStyle}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ProgressBar Height="4" IsIndeterminate="{Binding IsOperationRunning}" />
          <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            AutomationProperties.LiveSetting="Polite"
            TargetUpdated="StatusTextTargetUpdated"
            Text="{Binding LastStatus, NotifyOnTargetUpdated=True}"
            TextWrapping="Wrap" />
        </Grid>
      </GroupBox>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>
